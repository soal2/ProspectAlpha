APP_ENV=development
APP_NAME=ProspectAlpha RiskAgent
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql+psycopg://prospect_alpha:prospect_alpha@localhost:5432/prospect_alpha
REDIS_URL=redis://localhost:6379/0
ANALYSIS_EXECUTION_MODE=inline
ANALYSIS_QUEUE_NAME=analysis
DOCUMENT_PARSING_EXECUTION_MODE=subprocess
DOCUMENT_PARSING_MAX_CONCURRENCY=1
DOCUMENT_PARSING_STALE_SECONDS=120
DOCUMENT_PARSING_HEARTBEAT_SECONDS=15
DOCUMENT_PARSING_DISPATCH_INTERVAL_SECONDS=10
DOCUMENT_PARSING_TASK_TIMEOUT_SECONDS=7200
DOCUMENT_PARSING_CPU_THREADS=2
DOCUMENT_QUEUE_NAME=documents
MINERU_DEVICE=auto
MINERU_CUDA_DEVICE=0
MINERU_CUDA_VISIBLE_DEVICES=
AGENT_RUNTIME_DATA_DIR=./data/agent_runtime
A2A_PUBLIC_BASE_URL=http://localhost:8000
A2A_SEND_TIMEOUT_SECONDS=300
LANGGRAPH_CHECKPOINT_BACKEND=sqlite
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_SECURE=0

OBJECT_STORE_PROVIDER=local
OBJECT_STORE_BUCKET=prospect-alpha
OBJECT_STORE_LOCAL_ROOT=./data/raw/object-store

OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
